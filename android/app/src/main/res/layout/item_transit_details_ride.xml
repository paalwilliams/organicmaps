<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingStart="@dimen/margin_base"
  android:paddingEnd="@dimen/margin_base"
  android:paddingTop="@dimen/margin_half"
  android:paddingBottom="@dimen/margin_quarter">

  <TextView
    android:id="@+id/board_at"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:textAppearance="?fontBody1"
    android:textColor="?android:attr/textColorPrimary"
    tools:text="Board at Sadovaya"
    xmlns:tools="http://schemas.android.com/tools"/>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/margin_base"
    android:layout_marginTop="@dimen/margin_quarter"
    android:layout_marginBottom="@dimen/margin_half_plus"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <app.organicmaps.routing.TransitStepView
      android:id="@+id/line_badge"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:minHeight="@dimen/routing_transit_step_min_height"
      android:textSize="@dimen/text_size_body_1"
      android:textColor="@android:color/white"
      android:paddingStart="@dimen/margin_quarter"
      android:paddingEnd="@dimen/margin_quarter"/>

    <TextView
      android:id="@+id/ride_subtitle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/margin_half_plus"
      android:textAppearance="?fontBody2"
      android:textColor="?secondary"
      tools:text="4 stops · 8 min"
      xmlns:tools="http://schemas.android.com/tools"/>
  </LinearLayout>

  <TextView
    android:id="@+id/intermediate_stops"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/margin_base"
    android:layout_marginBottom="@dimen/margin_half_plus"
    android:visibility="gone"
    android:textAppearance="?fontBody2"
    android:textColor="?secondary"
    tools:visibility="visible"
    tools:text="Frunzenskaya · Sportivnaya · Vorobyovy Gory"
    xmlns:tools="http://schemas.android.com/tools"/>

  <TextView
    android:id="@+id/alight_at"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:textAppearance="?fontBody1"
    android:textColor="?android:attr/textColorPrimary"
    tools:text="Alight at Tekstilshiki"
    xmlns:tools="http://schemas.android.com/tools"/>
</LinearLayout>
